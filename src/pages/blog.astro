---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import esquemaDesenhado from '../assets/image/esquema_desenhado_prot.jpeg';
import schematicOficina from '../assets/image/Schematic_Oficina_2026-05-21.png';
import diagramaBlocos from '../assets/image/Diagramas Oficina.png';
import montagemProtoboard from '../assets/image/protoboard.jpg';
import prototipo from '../assets/image/prototipo.jpeg';
import protCima from '../assets/image/prot_cima.jpeg';

const atualizacoes = [
  {
    data: '10 de abril de 2026',
    titulo: 'Apresentação do plano do projeto',
    conteudo: 'Apresentamos o plano do projeto para a turma e professores. Foram definidos o escopo, as funcionalidades principais e a arquitetura do sistema.',
    arquivos: [
      { href: '/arquivos/Proposta - Plano de Projeto - Equipe Inventario.pdf', label: 'Plano do Projeto' },
      { href: '/arquivos/Apresentação Proposta.pdf', label: 'Slides' },
    ],
    imagens: [
      { src: diagramaBlocos, alt: 'Diagrama de Blocos' },
    ],
  },
  {
    data: '17 de Abril de 2026',
    titulo: 'Apresentação Entregável 1',
    conteudo: 'Apresentamos o site/blog de acompanhamento do nosso projeto, desenvolvido para que o professor possa acompanhar sua evolução. Nele serão registradas todas as atualizações, etapas de desenvolvimento e principais avanços, servindo como uma documentação contínua do projeto ao longo de sua execução.',
  },
  {
    data: '24 de Abril de 2026',
    titulo: 'Montagem Inicial em Protoboard',
    conteudo: 'Fizemos a montagem inicial do circuito em uma protoboard, testando as conexões.',
    imagens: [
      { src: montagemProtoboard, alt: 'Montagem em Protoboard' },
    ],
  
  },
  {
    data: '01 de Maio de 2026',
    titulo: 'Desenvolvimento do esquemático físico e testes do sensores',
    conteudo: 'Desenvolvemos o esquemático da estrutura física do projeto, ademais, testamos os sensores Hx711 e RC522 conectando-os a ESP32, para medir o peso e ler as etiquetas RFID, respectivamente.',
    imagens: [
      { src: esquemaDesenhado, alt: 'Esquema desenhado' },
    ],
  },
  {
    data: '08 de maio de 2026',
    titulo: 'Desenvolvimento do esquemático eletrônico e criação das tabelas.',
    conteudo: 'Desenvolvemos o esquemático eletrônico, definindo os componentes e a estrutura do circuito. Ademais, fizemos a instalação do banco de dados e criação das tabelas.',
    imagens: [
      { src: schematicOficina, alt: 'Schematic Oficina' },
    ],
  },
  {
    data: '15 de Maio de 2026',
    titulo: 'Conclusão do desenvolvimento do protótipo',
    conteudo: 'Concluímos o desenvolvimento do protótipo, integrando todos os componentes eletrônicos e testando suas funcionalidades, além de ajustes finais na estrutura física.',
    imagens: [
      { src: prototipo, alt: 'Protótipo' },
      { src: protCima, alt: 'Protótipo visto de cima' },
    ],
  },
  {
    data: '22 de Maio de 2026',
    titulo: 'Apresentação Entregável 2/3',
    conteudo: 'Apresentamos o design de estrutura do nosso projeto ao professor. O projeto possui uma caixa patola conectada a uma célula de carga, esta conectada com uma chapa de acrílico onde os objetos a serem pesados serão colocados. Ademais, criamos as tabelas e a instalamos os bancos de dados para o gerenciamento dos estoques. Por último, fizemos a apresentação do projeto montado, demonstrando testes de hardware que garantem que os sensores ',
  },
  {
    data: '05 de Junho de 2026',
    titulo: 'Desenvolvimento da interface visual',
    conteudo: 'Fizemos a interface visual que integra o controle do estoque pelo banco de dados. Os valores de entrada são inseridos à mão, para depois serem integrados a estrutura mecânica.',
  },
  {
    data: '12 de Junho de 2026',
    titulo: 'Integração com a API do Mercado Pago',
    conteudo: 'Fizemos a integração com a API para realizarmos PIX e fazer a venda de itens do estoque.',
  },
  {
    data: '19 de Junho de 2026',
    titulo: 'Apresentação Entregável 4',
  },
];
---

<Layout title="Blog" description="Atualizações e progresso do projeto">
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Blog</h1>
      <p class="text-gray-500 mb-12">Acompanhe as atualizações e o progresso do projeto.</p>

      <div class="relative">
        <!-- Linha vertical -->
        <div class="absolute left-4 top-0 bottom-0 w-px bg-gray-200"></div>

        <div class="space-y-10">
          {atualizacoes.map(item => (
            <div class="relative pl-12">
              <!-- Bolinha na linha -->
              <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center">
                <div class="w-2 h-2 rounded-full bg-white"></div>
              </div>

              <p class="text-xs font-medium text-indigo-600 uppercase tracking-wide mb-1">{item.data}</p>
              <h2 class="text-lg font-semibold text-gray-900 mb-2">{item.titulo}</h2>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">{item.conteudo}</p>

              {item.imagens && (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                  {item.imagens.map(img => (
                    <Image
                      src={img.src}
                      alt={img.alt}
                      class="rounded-lg shadow-sm w-full h-auto object-cover"
                    />
                  ))}
                </div>
              )}

              {item.arquivos && (
                <div class="flex flex-wrap gap-3 mt-4">
                  {item.arquivos.map(arquivo => (
                    <a
                      href={arquivo.href}
                      download
                      class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-indigo-200 bg-indigo-50 text-indigo-700 text-xs font-medium hover:bg-indigo-100 transition-colors"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                      </svg>
                      {arquivo.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>