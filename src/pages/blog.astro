---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import esquemaDesenhado from '../assets/image/esquema_desenhado_prot.jpeg';
import schematicOficinas from '../assets/image/Schematic_Oficinas2_2026-05-21.png';
import prototipo from '../assets/image/prototipo.jpeg';
import protCima from '../assets/image/prot_cima.jpeg';

// Para adicionar as imagens dos entregáveis 4 e 5:
//   1. Coloque o arquivo em src/assets/image/
//   2. Descomente a importação correspondente abaixo
//   3. No node, troque `imagemPlaceholder: '...'` por
//      `imagens: [{ src: entregavel4, alt: 'Entregável 4' }]`
// import entregavel4 from '../assets/image/entregavel4.jpeg';
// import entregavel5 from '../assets/image/entregavel5.jpeg';

const atualizacoes = [
  {
    data: '10 de abril de 2026',
    titulo: 'Apresentação do plano do projeto',
    conteudo: 'Apresentamos o plano do projeto para a turma e professores. Foram definidos o escopo, as funcionalidades principais e a arquitetura do sistema.',
  },
  {
    data: '08 de maio de 2026',
    titulo: 'Desenvolvimento do esquemático físico e eletrônico',
    conteudo: 'Desenvolvemos o esquemático físico e eletrônico do protótipo, definindo os componentes e a estrutura do circuito. Tamém projetamos a estrutura física para acomodar os componentes eletrônicos.',
    imagens: [
      { src: esquemaDesenhado, alt: 'Esquema desenhado' },
      { src: schematicOficinas, alt: 'Schematic Oficinas 2' },
    ],
  },
  {
    data: '15 de Maio de 2026',
    titulo: 'Conclusão do desenvolvimento do protótipo',
    conteudo: 'Concluímos o desenvolvimento do protótipo, integrando todos os componentes eletrônicos e testando suas funcionalidades, além de ajustes finais na estrutura física.',
    imagens: [
      { src: prototipo, alt: 'Protótipo' },
      { src: protCima, alt: 'Protótipo visto de cima' },
    ],
  },
  {
    data: '19 de junho de 2026',
    titulo: 'Apresentação do Entregável 4 — Projeto do software e testes de módulos',
    conteudo: 'Apresentamos o Entregável 4, focado no desenvolvimento do software e nos testes dos módulos individuais. Desenvolvemos a interface visual com atualização em tempo real, implementamos a integração com a API de Pix (geração de PIX dinâmico via QR Code e Copia/Cola), integramos o QR Code à interface do computador e criamos as rotinas de verificação de pagamento e de reversão (rollback) caso o PIX expire.',
    imagemPlaceholder: 'Adicione aqui o print do entregável 4 (recorte do cronograma / Gantt).',
  },
  {
    data: '03 de julho de 2026',
    titulo: 'Apresentação do Entregável 5 — Integração mecânica, hardware e software',
    conteudo: 'Apresentamos o Entregável 5, focado na integração completa entre mecânica, hardware e software. Fixamos os sensores e o ESP32 na estrutura da balança, realizamos o teste integrado (remoção de peça → atualização da UI → geração de Pix), fizemos a calibração fina com as caixas e peças reais, executamos uma bateria de testes de usuário (comportamentos inesperados, falha de internet, remoção da caixa durante o PIX), tratamos os bugs encontrados e fizemos os ajustes finais de usabilidade da interface.',
    imagemPlaceholder: 'Adicione aqui o print do entregável 5 (recorte do cronograma / Gantt).',
  },
];
---

<Layout title="Blog" description="Atualizações e progresso do projeto">
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Blog</h1>
      <p class="text-gray-500 mb-12">Acompanhe as atualizações e o progresso do projeto.</p>

      <div class="relative">
        <!-- Linha vertical -->
        <div class="absolute left-4 top-0 bottom-0 w-px bg-gray-200"></div>

        <div class="space-y-10">
          {atualizacoes.map(item => (
            <div class="relative pl-12">
              <!-- Bolinha na linha -->
              <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center">
                <div class="w-2 h-2 rounded-full bg-white"></div>
              </div>

              <p class="text-xs font-medium text-indigo-600 uppercase tracking-wide mb-1">{item.data}</p>
              <h2 class="text-lg font-semibold text-gray-900 mb-2">{item.titulo}</h2>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">{item.conteudo}</p>

              {item.imagens && (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                  {item.imagens.map(img => (
                    <Image
                      src={img.src}
                      alt={img.alt}
                      class="rounded-lg shadow-sm w-full h-auto object-cover"
                    />
                  ))}
                </div>
              )}

              {item.imagemPlaceholder && (
                <div class="mt-4 flex h-56 items-center justify-center rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 px-4 text-center">
                  <div>
                    <p class="text-sm font-medium text-gray-500">Espaço reservado para imagem</p>
                    <p class="mt-1 text-xs text-gray-400">{item.imagemPlaceholder}</p>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
